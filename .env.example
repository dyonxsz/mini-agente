# Copie este arquivo para .env e preencha com os seus dados.
# NUNCA publique o .env no GitHub.

# Aula 1 em diante: chave da API.
# Neste curso estou usando a mesma chave do projeto Observa Cidade. Ela é do
# Gemini e fica na variável GEMINI_API_KEY do Windows. O SDK da OpenAI fala
# com o Gemini pelo endereço abaixo.
# Se o professor entregar uma chave da OpenAI (sk-...), troque a linha da
# chave e apague a OPENAI_BASE_URL.
OPENAI_API_KEY=${GEMINI_API_KEY}
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.5-flash-lite

# Aula 7 em diante: banco de dados do seu projeto (SQLite por padrão)
# DATABASE_URL=sqlite:///dados/projeto.db
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/projeto
# DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/projeto
